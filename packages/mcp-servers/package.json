{
  "name": "@comitiva/mcp-servers",
  "version": "0.1.0",
  "description": "Built-in MCP servers for Comitiva (filesystem with roots, google-drive)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "comitiva-mcp-filesystem": "dist/filesystem.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./filesystem-bin": "./dist/filesystem.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsup --silent && vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsup": "^8.5.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  }
}
