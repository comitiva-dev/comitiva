{
  "name": "desktop",
  "productName": "Comitiva",
  "desktopName": "comitiva.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Comitiva desktop app — agentic chat for your whole team",
  "license": "Apache-2.0",
  "author": "Comitiva contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "db:generate": "drizzle-kit generate",
    "package": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@comitiva/contract": "workspace:*",
    "@comitiva/runner": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.14",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "ulid": "^3.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
