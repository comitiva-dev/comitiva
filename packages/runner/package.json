{
  "name": "@comitiva/runner",
  "version": "0.1.0",
  "description": "Comitiva runner: standalone Node process that owns all LLM execution, spoken to over JSON lines",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "comitiva-runner": "./dist/bin.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./bin": "./dist/bin.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/bin.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsup --silent && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@comitiva/contract": "workspace:*",
    "@google/genai": "^2.23.0",
    "openai": "^7.19.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13"
  }
}
