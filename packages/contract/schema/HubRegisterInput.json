{
  "$id": "https://comitiva.dev/schema/HubRegisterInput.json",
  "title": "HubRegisterInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "maxLength": 255,
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "deviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "invitationToken": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "password",
    "deviceName"
  ]
}
